POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_DB=care
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@db:5432/care
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0

DJANGO_DEBUG=true
ATTACH_DEBUGGER=false
KEYCLOAK_ISSUER=http://localhost:8082/realms/care
KEYCLOAK_AUDIENCE=doctor-webapp
KEYCLOAK_JWKS_URL=http://host.docker.internal:8082/realms/care/protocol/openid-connect/certs


BUCKET_REGION=ap-south-1
BUCKET_KEY=${MINIO_ACCESS_KEY:-minioadmin}
BUCKET_SECRET=${MINIO_SECRET_KEY:-minioadmin}
BUCKET_ENDPOINT=http://minio:9000
BUCKET_EXTERNAL_ENDPOINT=http://localhost:9100
FILE_UPLOAD_BUCKET=patient-bucket
FACILITY_S3_BUCKET=facility-bucket

CARE_MACHINE_USER_PASSWORD_FILE=/run/secrets/sync-bot-password.txt
CARE_AUTH_REFRESH_ENABLED=true
CARE_AUTH_REFRESH_PATH=/api/v1/auth/token/refresh/
CARE_AUTH_MAX_SESSION_AGE_MINUTES=60
CARE_EXPIRY_SKEW_SECONDS=300